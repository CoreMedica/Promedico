---

import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/pages/_about.scss";

const bookingUrl =
  "https://www.fresha.com/book-now/promedico-ear-clinic-ppaqx3l8/all-offer?share=true&pId=3035851";

const pageTitle =
  "About Promedico Wellness Group | Practitioner-Led Ear Care";

const pageDescription =
  "Learn about Promedico Wellness Group, a practitioner-led private ear care service providing clinic appointments and home visit earwax removal in Portsmouth and Southampton.";

const siteUrl = "https://promedico.co.uk";
const orgId = `${siteUrl}/#organization`;
const websiteId = `${siteUrl}/#website`;

const aboutSchema = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "@id": `${siteUrl}/about#webpage`,
    url: `${siteUrl}/about`,
    name: pageTitle,
    description: pageDescription,
    inLanguage: "en-GB",
    isPartOf: {
      "@id": websiteId
    },
    about: {
      "@id": orgId
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "MedicalBusiness",
    "@id": orgId,
    name: "Promedico Wellness Group",
    url: siteUrl,
    image: `${siteUrl}/images/ProMedico-Logo-text.webp`,
    logo: `${siteUrl}/images/ProMedico-Logo-text.webp`,
    telephone: "+447777100716",
    email: "reception@promedico.co.uk",
    priceRange: "££",
    medicalSpecialty: "Otolaryngologic",
    areaServed: [
      {
        "@type": "City",
        name: "Portsmouth"
      },
      {
        "@type": "City",
        name: "Southampton"
      }
    ],
    department: [
      { "@id": `${siteUrl}/services/ear-care/portsmouth#clinic` },
      { "@id": `${siteUrl}/services/ear-care/southampton#clinic` }
    ],
    sameAs: [
      "https://share.google/RWDPc31aOTjqvBc8F",
      "https://www.facebook.com/promedicoearclinic/"
    ],
    openingHoursSpecification: [
      {
        "@type": "OpeningHoursSpecification",
        dayOfWeek: "Thursday",
        opens: "14:00",
        closes: "18:00"
      },
      {
        "@type": "OpeningHoursSpecification",
        dayOfWeek: "Saturday",
        opens: "08:00",
        closes: "12:00"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": `${siteUrl}/about#jacqueline-allen`,
    name: "Jacqueline Allen",
    jobTitle: "Advanced Clinical Practitioner",
    worksFor: {
      "@id": orgId
    },
    hasCredential: [
      {
        "@type": "EducationalOccupationalCredential",
        credentialCategory: "professional certification",
        name: "HCPC Registered Paramedic"
      },
      {
        "@type": "EducationalOccupationalCredential",
        credentialCategory: "professional certification",
        name: "Independent and Supplementary Prescriber"
      },
      {
        "@type": "EducationalOccupationalCredential",
        credentialCategory: "degree",
        name: "MSc Advanced Clinical Practice"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": `${siteUrl}/about#david`,
    name: "David Cadwallader",
    jobTitle: "Ear Care Practitioner",
    worksFor: {
      "@id": orgId
    },
    knowsAbout: [
      "Microsuction",
      "Ear irrigation",
      "Patient relations",
      "Website management",
      "Healthcare marketing"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${siteUrl}/about#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: `${siteUrl}/`
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "About",
        item: `${siteUrl}/about`
      }
    ]
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage="/images/team/jacqueline-allen.webp"
  ogDescription="Learn about Promedico's practitioner-led approach to private ear care, with clinic appointments and home visits in Portsmouth and Southampton."
  schema={aboutSchema}
  preloadImage="/images/about/about-hero-ear-care.webp"
>
    <section class="hero hero--image hero--about" aria-labelledby="about-hero-heading">
      <div class="hero__bg-pattern" aria-hidden="true"></div>

      <div class="container">
        <div class="hero__inner">
          <p class="hero__eyebrow">About Promedico Wellness Group</p>

          <h1 class="hero__heading" id="about-hero-heading">
            Practitioner-Led Ear Care<br />
            <span class="hero__heading-accent">with a Clinical Foundation</span>
          </h1>

          <p class="hero__subheading">
            Promedico Wellness Group provides professional ear care and earwax removal services
            across Portsmouth and Southampton, with a clear focus on assessment, suitability,
            patient communication and appropriate treatment.
          </p>

          <div class="hero__ctas">
            <a class="btn btn--primary" href={bookingUrl} target="_blank" rel="noopener">
              Book Online
            </a>

            <a class="btn btn--outline-light" href="/contact">
              Contact Us
            </a>
          </div>

          <ul class="hero__trust-list" aria-label="Promedico key trust points">
            <li class="hero__trust-item">Practitioner-led ear care</li>
            <li class="hero__trust-item">Microsuction and irrigation available where suitable</li>
            <li class="hero__trust-item">Clinic appointments in Portsmouth and Southampton</li>
            <li class="hero__trust-item">Home visits available in both areas</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="private-ear-care-heading">
      <div class="container">
        <header class="section-header">
          <h2 class="section-header__heading" id="private-ear-care-heading">
            Private Ear Care, Delivered Properly
          </h2>

          <p class="section-header__lead">
            Promedico Wellness Group has been developed to provide safe, professional and
            patient-centred private healthcare services, beginning with specialist ear care and
            earwax removal.
          </p>
        </header>

        <div class="about-intro__grid">
          <div class="about-intro__content">
            <p>
              The current service focuses on ear assessment and earwax removal appointments in
              Portsmouth and Southampton. Patients can choose clinic appointments or home visits
              in either area, depending on location and preference.
            </p>

            <p>
              The aim is simple: to provide clear, appropriate care without unnecessary complexity.
              Every appointment is approached clinically, with assessment first and treatment only
              carried out where suitable.
            </p>
          </div>

          <aside class="about-intro__panel" aria-label="Promedico service summary">
            <ul class="about-intro__facts">
              <li>Clinic appointments in Portsmouth and Southampton</li>
              <li>Home visits available in both areas</li>
              <li>Ear assessment before treatment</li>
              <li>Earwax removal where clinically suitable</li>
            </ul>
          </aside>
        </div>
      </div>
    </section>

    <section class="section section--light" aria-labelledby="clinical-background-heading">
      <div class="container">
        <header class="section-header">
          <h2 class="section-header__heading" id="clinical-background-heading">
            A Clinical Background, Not a Retail Model
          </h2>

          <p class="section-header__lead">
            Promedico is built around practitioner-led care. That matters because earwax removal
            should not be treated as a quick, mechanical procedure.
          </p>
        </header>

        <ul class="service-cards">
          <li class="service-card">
            <div class="service-card__body">
              <h3 class="service-card__heading">Practitioner-Led Care</h3>

              <p class="service-card__text">
                Safe care starts with understanding the patient, checking the ear properly,
                explaining the options and only proceeding when treatment is appropriate.
              </p>
            </div>
          </li>

          <li class="service-card">
            <div class="service-card__body">
              <h3 class="service-card__heading">Clinical Foundation</h3>

              <p class="service-card__text">
                Promedico Wellness Group forms part of the wider Promedico background, with
                long-standing experience supporting healthcare services across NHS, urgent care and
                primary care environments.
              </p>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="team-heading">
      <div class="container">
        <header class="section-header">
          <h2 class="section-header__heading" id="team-heading">
            Meet the Promedico Team
          </h2>

          <p class="section-header__lead">
            Promedico ear care is delivered by a focused local team, with clinical leadership
            from Jacqueline Allen and ear care appointments supported by trained practitioners.
          </p>
        </header>

        <div class="procedure-cards procedure-cards--two-col">
          <article class="procedure-card">
            <div class="procedure-card__body">
              <p class="procedure-card__eyebrow">Clinical lead</p>

              <h3 class="procedure-card__title">Jacqueline Allen</h3>

              <p class="procedure-card__text">
                Jacqueline is an Advanced Clinical Practitioner with over 15 years' experience
                across primary care, urgent care and paramedicine.
              </p>

              <p class="procedure-card__text">
                She is an HCPC Registered Paramedic and an independent and supplementary
                prescriber, with an MSc Advanced Clinical Practice background and experience
                across NHS, urgent care and primary care settings.
              </p>

              <ul class="service-card__features">
                <li>Advanced Clinical Practitioner</li>
                <li>HCPC Registered Paramedic</li>
                <li>Independent and supplementary prescriber</li>
                <li>MSc Advanced Clinical Practice background</li>
                <li>Over 15 years' clinical experience</li>
              </ul>
            </div>
          </article>

          <article class="procedure-card">
            <div class="procedure-card__body">
              <p class="procedure-card__eyebrow">Ear care practitioner</p>

              <h3 class="procedure-card__title">David Cadwallader</h3>

              <p class="procedure-card__text">
                David provides ear care appointments within his scope of practice, focused on
                microsuction and ear irrigation where appropriate.
              </p>

              <p class="procedure-card__text">
                He has completed nationally recognised CPD training in microsuction and ear
                irrigation, and also supports Promedico's website, marketing and patient
                relations.
              </p>

              <ul class="service-card__features">
                <li>Microsuction-trained</li>
                <li>Ear irrigation-trained</li>
                <li>Nationally recognised CPD training completed</li>
                <li>Patient relations and service support</li>
                <li>Website and marketing management</li>
              </ul>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="section section--light" aria-labelledby="approach-heading">
      <div class="container">
        <header class="section-header">
          <h2 class="section-header__heading" id="approach-heading">
            Our Approach to Ear Care
          </h2>

          <p class="section-header__lead">
            Promedico's approach is built around safety, clarity and appropriate treatment.
          </p>
        </header>

        <div class="procedure-cards">
          <article class="procedure-card">
            <div class="procedure-card__body">
              <p class="procedure-card__eyebrow">Step 1</p>

              <h3 class="procedure-card__title">Assessment First</h3>

              <p class="procedure-card__text">
                Every appointment begins with a discussion of your symptoms and an examination of
                the ear canal. This helps establish whether wax is present and whether removal is
                appropriate.
              </p>
            </div>
          </article>

          <article class="procedure-card">
            <div class="procedure-card__body">
              <p class="procedure-card__eyebrow">Step 2</p>

              <h3 class="procedure-card__title">Treatment Where Suitable</h3>

              <p class="procedure-card__text">
                If treatment is suitable, earwax removal may be carried out using clinically
                recognised methods such as microsuction or ear irrigation. Treatment is not carried
                out where it would be inappropriate to do so.
              </p>
            </div>
          </article>

          <article class="procedure-card">
            <div class="procedure-card__body">
              <p class="procedure-card__eyebrow">Step 3</p>

              <h3 class="procedure-card__title">Aftercare Advice</h3>

              <p class="procedure-card__text">
                Aftercare advice is provided following the appointment, including guidance on ear
                care and what to do if symptoms persist or further support is needed.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="appointments-heading">
      <div class="container">
        <header class="section-header">
          <h2 class="section-header__heading" id="appointments-heading">
            Clinic and Home Visit Appointments
          </h2>

          <p class="section-header__lead">
            Promedico provides clinic appointments and home visit appointments in Portsmouth
            and Southampton.
          </p>
        </header>

        <ul class="service-cards service-cards__three-col">
          <li class="service-card">
            <div class="service-card__body">
              <h3 class="service-card__heading">Portsmouth Clinic</h3>

              <p class="service-card__text">
                Clinic appointments are available at Somerstown Central Community Hub,
                Winston Churchill Avenue, Southsea, Portsmouth, PO5 4JJ.
              </p>

              <a class="btn btn--primary service-card__link" href="/services/ear-care/portsmouth">
                View Portsmouth Ear Care
              </a>
            </div>
          </li>

          <li class="service-card">
            <div class="service-card__body">
              <h3 class="service-card__heading">Southampton Clinic</h3>

              <p class="service-card__text">
                Clinic appointments are available at 4 Chessel Avenue, Bitterne,
                Southampton, SO19 4AA.
              </p>

              <a class="btn btn--primary service-card__link" href="/services/ear-care/southampton">
                View Southampton Ear Care
              </a>
            </div>
          </li>

          <li class="service-card">
            <div class="service-card__body">
              <h3 class="service-card__heading">Home Visits</h3>

              <p class="service-card__text">
                Home visits are available across Portsmouth and Southampton for patients who
                prefer to be seen at home or who may find travelling to clinic less convenient.
              </p>

              <a class="btn btn--primary service-card__link" href="/contact">
                Ask About a Home Visit
              </a>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <section class="section section--light about-why-choose" aria-labelledby="why-heading">
      <div class="container">
        <header class="section-header">
          <h2 class="section-header__heading" id="why-heading">
            Why Patients Choose Promedico
          </h2>

          <p class="section-header__lead">
            A conservative, clinical and patient-centred approach to private ear care.
          </p>
        </header>

        <ul class="service-cards about-why-choose__grid">
          <li class="service-card">
            <div class="service-card__body">
              <h3 class="service-card__heading">Practitioner-Led Care</h3>

              <p class="service-card__text">
                Appointments are delivered by trained practitioners working within their scope,
                with clinical leadership from an experienced Advanced Clinical Practitioner.
              </p>
            </div>
          </li>

          <li class="service-card">
            <div class="service-card__body">
              <h3 class="service-card__heading">Professional Ear Assessment</h3>

              <p class="service-card__text">
                Earwax removal starts with assessment. The service is designed to check suitability
                before treatment, not simply proceed by default.
              </p>
            </div>
          </li>

          <li class="service-card">
            <div class="service-card__body">
              <h3 class="service-card__heading">Clear, Conservative Care</h3>

              <p class="service-card__text">
                Promedico avoids exaggerated claims. The focus is on safe, appropriate,
                patient-centred care with clear communication.
              </p>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="services-heading">
      <div class="container">
        <header class="section-header">
          <h2 class="section-header__heading" id="services-heading">
            Ear Care Services
          </h2>

          <p class="section-header__lead">
            Choose the service page that matches your location.
          </p>
        </header>

        <ul class="service-cards">
          <li class="service-card">
            <div class="service-card__body">
              <h3 class="service-card__heading">Portsmouth Ear Care</h3>

              <p class="service-card__text">
                Clinic appointments and home visits for earwax removal in Portsmouth.
              </p>

              <a class="btn btn--primary service-card__link" href="/services/ear-care/portsmouth">
                View Portsmouth Ear Care
              </a>
            </div>
          </li>

          <li class="service-card">
            <div class="service-card__body">
              <h3 class="service-card__heading">Southampton Ear Care</h3>

              <p class="service-card__text">
                Clinic appointments and home visits for earwax removal in Southampton.
              </p>

              <a class="btn btn--primary service-card__link" href="/services/ear-care/southampton">
                View Southampton Ear Care
              </a>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <section class="svc-booking" aria-labelledby="booking-heading">
      <div class="container">
        <div class="svc-booking__inner svc-booking__inner--no-map">
          <div class="svc-booking__content">
            <p class="svc-booking__eyebrow">Book an appointment</p>

            <h2 class="svc-booking__heading" id="booking-heading">
              Book an Ear Care Appointment
            </h2>

            <p class="svc-booking__text">
              Book online for clinic appointments in Portsmouth or Southampton. For home visits,
              contact Promedico so we can confirm your area and appointment availability.
            </p>

            <div class="svc-booking__ctas">
              <a class="btn btn--primary" href={bookingUrl} target="_blank" rel="noopener">
                Book Online
              </a>

              <a class="btn btn--outline" href="/contact">
                Contact Us
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
</BaseLayout>