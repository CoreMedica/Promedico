---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/pages/_contact.scss";

import LocationDotIcon from "../assets/icons/fontawesome/location-dot.svg?raw";

const bookingUrl =
  "https://promedico-ear-clinic.uk2.cliniko.com/bookings?business_id=1799806171821907984";

const siteUrl = "https://promedico.co.uk";
const orgId = `${siteUrl}/#organization`;
const websiteId = `${siteUrl}/#website`;

const pageTitle =
  "Contact Promedico | Ear Care Appointments & Home Visits";

const pageDescription =
  "Contact Promedico about clinic appointments or home visit earwax removal in Portsmouth and Southampton, or questions before booking.";

const pageImage = "/images/contact/somerstown-central-hub.webp";

const contactSchema = [
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "@id": `${siteUrl}/contact#webpage`,
    url: `${siteUrl}/contact`,
    name: pageTitle,
    description: pageDescription,
    inLanguage: "en-GB",
    isPartOf: {
      "@id": websiteId
    },
    about: {
      "@id": orgId
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "MedicalBusiness",
    "@id": orgId,
    name: "Promedico Wellness Group",
    url: siteUrl,
    image: `${siteUrl}/images/ProMedico-Logo-text.webp`,
    logo: `${siteUrl}/images/ProMedico-Logo-text.webp`,
    telephone: "+447777100716",
    email: "reception@promedico.co.uk",
    priceRange: "££",
    medicalSpecialty: "Otolaryngologic",
    areaServed: [
      {
        "@type": "City",
        name: "Portsmouth"
      },
      {
        "@type": "City",
        name: "Southampton"
      }
    ],
    department: [
      { "@id": `${siteUrl}/services/ear-care/portsmouth#clinic` },
      { "@id": `${siteUrl}/services/ear-care/southampton#clinic` }
    ],
    sameAs: [
      "https://share.google/RWDPc31aOTjqvBc8F",
      "https://www.facebook.com/promedicoearclinic/"
    ],
    openingHoursSpecification: [
      {
        "@type": "OpeningHoursSpecification",
        dayOfWeek: "Thursday",
        opens: "14:00",
        closes: "18:00"
      },
      {
        "@type": "OpeningHoursSpecification",
        dayOfWeek: "Saturday",
        opens: "08:00",
        closes: "12:00"
      }
    ],
    contactPoint: [
      {
        "@type": "ContactPoint",
        contactType: "appointments and enquiries",
        telephone: "+447777100716",
        email: "reception@promedico.co.uk",
        areaServed: "GB",
        availableLanguage: "en-GB"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${siteUrl}/contact#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: `${siteUrl}/`
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Contact",
        item: `${siteUrl}/contact`
      }
    ]
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={pageImage}
  ogTitle="Contact Promedico | Ear Care Appointments & Home Visits"
  ogDescription="Contact Promedico about clinic appointments, local home visits, and ear care questions before booking."
  schema={contactSchema}
  preloadImage="/images/contact/somerstown-central-hub.webp"
>
    <section class="hero hero--image hero--contact" aria-labelledby="contact-hero-heading">
      <div class="hero__bg-pattern" aria-hidden="true"></div>

      <div class="container">
        <div class="hero__inner">
          <p class="hero__eyebrow">Contact Promedico</p>

          <h1 class="hero__heading" id="contact-hero-heading">
            Contact Promedico<br />
            <span class="hero__heading-accent">Wellness Group</span>
          </h1>

          <p class="hero__subheading">
            Contact Promedico about clinic appointments or home visit earwax removal in
            Portsmouth and Southampton, or questions before booking.
          </p>

          <div class="hero__ctas">
            <a class="btn btn--primary" href={bookingUrl} target="_blank" rel="noopener">
              Book Online
            </a>

            <a class="btn btn--outline-light" href="#contact-form">
              Send an Enquiry
            </a>
          </div>

          <ul class="hero__trust-list" aria-label="Promedico contact options">
            <li class="hero__trust-item">Portsmouth clinic enquiries</li>
            <li class="hero__trust-item">Southampton clinic enquiries</li>
            <li class="hero__trust-item">Home visit enquiries</li>
            <li class="hero__trust-item">Practitioner-led ear care</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section section--light" aria-labelledby="contact-options-heading">
      <div class="container">
        <header class="section-header">
          <h2 class="section-header__heading" id="contact-options-heading">
            How Can We Help?
          </h2>

          <p class="section-header__lead">
            Use the contact form for general enquiries. If you are ready to arrange an appointment,
            online booking is usually the quickest route.
          </p>
        </header>

        <ul class="service-cards">
          <li class="service-card">
            <div class="service-card__body">
              <h3 class="service-card__heading">Book a Clinic Appointment</h3>

              <p class="service-card__text">
                Use the online booking system if you want to arrange a clinic appointment
                in Portsmouth or Southampton.
              </p>

              <ul class="service-card__features">
                <li>Portsmouth clinic appointments</li>
                <li>Southampton clinic appointments</li>
                <li>Book directly online</li>
              </ul>

              <a class="btn btn--primary service-card__link" href={bookingUrl} target="_blank" rel="noopener">
                Book Clinic Appointment
              </a>
            </div>
          </li>

          <li class="service-card">
            <div class="service-card__body">
              <h3 class="service-card__heading">Request a Home Visit or Ask a Question</h3>

              <p class="service-card__text">
                Use the contact form if you are asking about a home visit in Portsmouth or
                Southampton, or if you are unsure which appointment type is most suitable.
              </p>

              <ul class="service-card__features">
                <li>Portsmouth home visit enquiries</li>
                <li>Southampton home visit enquiries</li>
                <li>Questions before booking</li>
              </ul>

              <a class="btn btn--outline service-card__link" href="#contact-form">
                Send an Enquiry
              </a>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="clinic-location-heading">
      <div class="container">
        <header class="section-header">
          <h2 class="section-header__heading" id="clinic-location-heading">
            Clinic Locations
          </h2>

          <p class="section-header__lead">
            Clinic appointments are available in Portsmouth and Southampton. Home visits are
            also available across both local areas.
          </p>
        </header>

        <ul class="service-cards">
          <li class="service-card service-card--coming-soon">
            <div class="service-card__body">
              <div class="service-card__header">
                <div class="service-card__icon-wrap" aria-hidden="true">
                  <span aria-hidden="true" set:html={LocationDotIcon}></span>
                </div>

                <h3 class="service-card__heading">Portsmouth Clinic</h3>
              </div>

              <p class="service-card__text">
                <strong>
                  Somerstown Central Community Hub<br />
                  Winston Churchill Avenue<br />
                  Southsea<br />
                  Portsmouth<br />
                  PO5 4JJ
                </strong>
              </p>

              <p class="service-card__text">
                Please book online before attending. The Portsmouth clinic is used for
                scheduled appointments only.
              </p>

              <a class="btn btn--primary service-card__link" href="/services/ear-care/portsmouth">
                View Portsmouth Ear Care
              </a>
            </div>
          </li>

          <li class="service-card">
            <div class="service-card__body">
              <div class="service-card__header">
                <div class="service-card__icon-wrap" aria-hidden="true">
                  <span aria-hidden="true" set:html={LocationDotIcon}></span>
                </div>

                <h3 class="service-card__heading">Southampton Clinic</h3>
              </div>

              <p class="service-card__text">
                <strong>
                  Promedico Southampton Clinic<br />
                  4 Chessel Avenue<br />
                  Bitterne<br />
                  Southampton<br />
                  SO19 4AA
                </strong>
              </p>

              <p class="service-card__text">
                Please book online before attending. The Southampton clinic is used for
                scheduled appointments only.
              </p>

              <a class="btn btn--primary service-card__link" href="/services/ear-care/southampton">
                View Southampton Ear Care
              </a>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <section class="section section--light" aria-labelledby="message-heading">
      <div class="container">
        <header class="section-header">
          <h2 class="section-header__heading" id="message-heading">
            Send Us a Message
          </h2>

          <p class="section-header__lead">
            Use the form below for appointment questions, home visit enquiries, service area
            queries, or anything you would like to clarify before booking. Do not use this form
            for urgent medical concerns.
          </p>
        </header>

        <div id="form-alert" class="form-alert" hidden></div>

        <form
          id="contact-form"
          class="contact-form"
          action="/php/contact.php"
          method="POST"
        >
          <div class="form-grid">
            <div class="form-field">
              <label for="name">Full name</label>
              <input type="text" id="name" name="name" autocomplete="name" required />
            </div>

            <div class="form-field">
              <label for="email">Email address</label>
              <input type="email" id="email" name="email" autocomplete="email" required />
            </div>

            <div class="form-field">
              <label for="phone">Phone number</label>
              <input type="tel" id="phone" name="phone" autocomplete="tel" />
            </div>

            <div class="form-field">
              <label for="service">Enquiry type</label>
              <select id="service" name="service">
                <option value="portsmouth-clinic">Portsmouth clinic appointment</option>
                <option value="portsmouth-home">Portsmouth home visit</option>
                <option value="southampton-clinic">Southampton clinic appointment</option>
                <option value="southampton-home">Southampton home visit</option>
                <option value="not-sure">Not sure</option>
              </select>
            </div>
          </div>

          <div class="form-field">
            <label for="message">Your message</label>
            <textarea
              id="message"
              name="message"
              rows="7"
              required
            ></textarea>
          </div>

          <div class="form-field form-field--checkbox">
            <input type="checkbox" id="consent" name="consent" value="yes" required />
            <label for="consent">
              I consent to Promedico Wellness Group using the details provided to respond to my
              enquiry. I understand this form is for appointment and service enquiries only.
            </label>
          </div>

          <input type="hidden" name="form_name" value="contact" />
          <input type="hidden" id="form-loaded-at" name="form_loaded_at" value="" />
          <input type="hidden" id="contact-csrf-token" name="csrf_token" value="" />
          <div class="form-field form-field--honeypot" aria-hidden="true">
            <label for="website">Website</label>
            <input
              type="text"
              id="website"
              name="website"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <div class="contact-form__actions">
            <button type="submit" class="btn btn--primary">Send Enquiry</button>

            <a class="btn btn--outline" href={bookingUrl} target="_blank" rel="noopener">
              Book Online Instead
            </a>
          </div>
        </form>
      </div>
    </section>

    <section class="section" aria-labelledby="before-contact-heading">
      <div class="container">
        <header class="section-header">
          <h2 class="section-header__heading" id="before-contact-heading">
            Before You Contact Us
          </h2>

          <p class="section-header__lead">
            A few common points to help you choose the right next step.
          </p>
        </header>

        <ul class="service-cards service-cards__three-col">
          <li class="service-card">
            <div class="service-card__body">
              <h3 class="service-card__heading">Booking a Clinic Appointment?</h3>

              <p class="service-card__text">
                Use the online booking system if you want to arrange a clinic appointment in
                Portsmouth or Southampton.
              </p>
            </div>
          </li>

          <li class="service-card">
            <div class="service-card__body">
              <h3 class="service-card__heading">Asking About a Home Visit?</h3>

              <p class="service-card__text">
                Please include your area or postcode so we can advise on availability for
                Portsmouth or Southampton home visits.
              </p>
            </div>
          </li>

          <li class="service-card">
            <div class="service-card__body">
              <h3 class="service-card__heading">Not Sure Which Option to Choose?</h3>

              <p class="service-card__text">
                Contact us and we can help you decide whether a clinic appointment or home visit
                is the more suitable route.
              </p>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <script>
      const loadedAtInput = document.getElementById("form-loaded-at") as HTMLInputElement;

      if (loadedAtInput) {
        loadedAtInput.value = String(Math.floor(Date.now() / 1000));
      }
      function generateCsrfToken(): string {
        if (window.crypto && "randomUUID" in crypto) {
          return crypto.randomUUID().replace(/-/g, "");
        }
        const bytes = new Uint8Array(16);
        crypto.getRandomValues(bytes);
        return Array.from(bytes, (b) => b.toString(16).padStart(2, "0")).join("");
      }

      const csrfToken = generateCsrfToken();
      document.cookie =
        `csrf_token=${csrfToken}; path=/; max-age=3600; samesite=strict` +
        (location.protocol === "https:" ? "; secure" : "");

      const csrfInput = document.getElementById("contact-csrf-token") as HTMLInputElement | null;
      if (csrfInput) {
        csrfInput.value = csrfToken;
      }
      const params = new URLSearchParams(window.location.search);
      const status = params.get("status");
      const alert = document.getElementById("form-alert");

      const messages = {
        success: {
          type: "success",
          title: "Your enquiry has been sent",
          text: "Thank you for contacting Promedico Wellness Group. We will respond as soon as we can."
        },
        "missing-fields": {
          type: "error",
          title: "Some required details are missing",
          text: "Please check the form and complete your name, email address, message, and consent."
        },
        "invalid-email": {
          type: "error",
          title: "Please check your email address",
          text: "The email address entered does not appear to be valid."
        },
        "message-too-long": {
          type: "error",
          title: "Your message is too long",
          text: "Please shorten your message and try again."
        },
        "send-failed": {
          type: "error",
          title: "Your enquiry could not be sent",
          text: "There was a problem sending your enquiry. Please try again, or contact us another way."
        },
        "invalid-method": {
          type: "error",
          title: "Invalid form request",
          text: "Please use the contact form on this page to send your enquiry."
        },
        "invalid-form": {
          type: "error",
          title: "Invalid form submission",
          text: "Please refresh the page and try again."
        },
        "invalid-service": {
          type: "error",
          title: "Invalid service option",
          text: "Please select a valid service area and try again."
        },
        "invalid-length": {
          type: "error",
          title: "Some details are too long",
          text: "Please shorten the relevant fields and try again."
        }
      };

      if (status && alert && Object.prototype.hasOwnProperty.call(messages, status)) {
        const message = messages[status as keyof typeof messages];

        alert.classList.add(`form-alert--${message.type}`);
        alert.setAttribute("role", message.type === "error" ? "alert" : "status");
        alert.innerHTML = `
          <h3 class="form-alert__title">${message.title}</h3>
          <p class="form-alert__text">${message.text}</p>
        `;
        alert.hidden = false;
      }
    </script>
</BaseLayout>