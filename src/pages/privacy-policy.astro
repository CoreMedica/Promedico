---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Privacy Policy | Promedico Wellness Group";

const pageDescription =
  "Privacy information for Promedico Wellness Group, including how we handle enquiries, appointment information, analytics and marketing data.";

const siteUrl = "https://promedico.co.uk";

const privacySchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${siteUrl}/privacy-policy#webpage`,
    url: `${siteUrl}/privacy-policy`,
    name: pageTitle,
    description: pageDescription,
    inLanguage: "en-GB"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${siteUrl}/privacy-policy#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: `${siteUrl}/`
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Privacy Policy",
        item: `${siteUrl}/privacy-policy`
      }
    ]
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={privacySchema}
>
  <section class="hero" aria-labelledby="privacy-heading">
    <div class="hero__bg-pattern" aria-hidden="true"></div>

    <div class="container">
      <div class="hero__inner">
        <p class="hero__eyebrow">Privacy</p>

        <h1 class="hero__heading" id="privacy-heading">
          Privacy Policy
        </h1>

        <p class="hero__subheading">
          This policy explains how Promedico Wellness Group collects, uses and protects
          personal information provided through this website and during enquiry handling.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-label="Privacy policy content">
    <div class="container">
      <div class="blog-post__content">
        <p><strong>Last updated:</strong> 22 May, 2026</p>

        <h2>Who we are</h2>
        <p>
          Promedico Wellness Group provides private ear care services, including ear assessment
          and earwax removal appointments in Portsmouth and Southampton.
        </p>

        <p>
          For privacy enquiries, contact:
          <a href="mailto:reception@promedico.co.uk">reception@promedico.co.uk</a>.
        </p>

        <h2>Information we collect</h2>
        <p>
          We may collect personal information when you contact us, submit an enquiry form,
          request a home visit, book an appointment, or communicate with us.
        </p>

        <p>This may include:</p>
        <ul>
          <li>Your name</li>
          <li>Email address</li>
          <li>Telephone number</li>
          <li>Postcode or service area</li>
          <li>Information you choose to include in your message</li>
          <li>Appointment-related information</li>
          <li>Basic technical information from website use, where cookies or analytics are accepted</li>
        </ul>

        <h2>How we use your information</h2>
        <p>We use personal information to:</p>
        <ul>
          <li>Respond to enquiries</li>
          <li>Arrange or manage appointments</li>
          <li>Provide information about our services</li>
          <li>Maintain appropriate administrative records</li>
          <li>Improve website performance and marketing, where analytics or advertising cookies are accepted</li>
          <li>Comply with legal, regulatory or professional obligations</li>
        </ul>

        <h2>Lawful bases for processing</h2>
        <p>
          Depending on the context, we may process your information because it is necessary to
          respond to your enquiry, take steps before entering into a service arrangement, provide
          healthcare-related services, comply with legal obligations, or pursue legitimate business
          interests where those interests are not overridden by your rights.
        </p>

        <p>
          Where we use non-essential cookies or advertising tags, we rely on your consent.
        </p>

        <h2>Health information</h2>
        <p>
          Information relating to health can be sensitive. Please do not use website forms for
          urgent medical concerns. Where health-related information is provided as part of an
          enquiry or appointment process, it will be handled with additional care and only used
          for relevant service, administrative or legal purposes.
        </p>

        <h2>Booking providers and third-party services</h2>
        <p>
          We may use third-party systems to manage appointment bookings, communications,
          website analytics and advertising measurement. These providers process information
          according to their own terms and privacy arrangements as well as any applicable
          agreements with us.
        </p>

        <p>
          The website may use Google and Microsoft/Bing services for analytics or advertising
          measurement if you consent to non-essential cookies.
        </p>

        <h2>Cookies and analytics</h2>
        <p>
          We use essential cookies or local storage where needed for website functionality.
          With your consent, we may use analytics and advertising cookies to understand website
          use and measure marketing effectiveness.
        </p>

        <p>
          More information is available in our <a href="/cookie-policy">Cookie Policy</a>.
        </p>

        <h2>How long we keep information</h2>
        <p>
          We keep personal information only for as long as necessary for the purpose it was
          collected, including enquiry handling, appointment administration, legal, accounting,
          regulatory or clinical record requirements where applicable.
        </p>

        <h2>Who we share information with</h2>
        <p>
          We may share information with service providers who help us operate the website,
          manage enquiries, process bookings, provide IT services, analyse website performance,
          or comply with legal obligations. We do not sell personal information.
        </p>

        <h2>Your rights</h2>
        <p>
          Depending on the circumstances, you may have rights to access, correct, erase, restrict
          or object to processing of your personal information, and to withdraw consent where
          processing is based on consent.
        </p>

        <p>
          To make a privacy request, contact
          <a href="mailto:reception@promedico.co.uk">reception@promedico.co.uk</a>.
        </p>

        <h2>Complaints</h2>
        <p>
          If you are unhappy with how your information is handled, please contact us first so we
          can try to resolve the issue. You also have the right to complain to the Information
          Commissioner's Office.
        </p>

        <h2>Changes to this policy</h2>
        <p>
          We may update this policy from time to time. The latest version will be published on
          this page.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>