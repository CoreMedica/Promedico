---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import "../../../styles/pages/_earwax.scss";
import HomeVisitModal from "../../../components/ui/HomeVisitModal.astro";

import BuildingIcon from "../../../assets/icons/fontawesome/building.svg?raw";
import HouseMedicalIcon from "../../../assets/icons/fontawesome/house-medical.svg?raw";
import ClipboardMedicalIcon from "../../../assets/icons/fontawesome/clipboard-medical.svg?raw";
import EarListenIcon from "../../../assets/icons/fontawesome/ear-listen.svg?raw";
import CommentMedicalIcon from "../../../assets/icons/fontawesome/comment-medical.svg?raw";
import LocationDotIcon from "../../../assets/icons/fontawesome/location-dot.svg?raw";
import CarSideIcon from "../../../assets/icons/fontawesome/car-side.svg?raw";
import EarDeafIcon from "../../../assets/icons/fontawesome/ear-deaf.svg?raw";
import VolumeLowIcon from "../../../assets/icons/fontawesome/volume-low.svg?raw";
import CircleInfoIcon from "../../../assets/icons/fontawesome/circle-info.svg?raw";
import UserDoctorIcon from "../../../assets/icons/fontawesome/user-doctor.svg?raw";
import HandHoldingMedicalIcon from "../../../assets/icons/fontawesome/hand-holding-medical.svg?raw";

const bookingUrl =
  "https://promedico-ear-clinic.uk2.cliniko.com/bookings?business_id=1799806171821907984";

const siteUrl = "https://promedico.co.uk";

const pageImage = "/images/contact/somerstown-central-hub.webp";

const pageTitle =
  "Earwax Removal Portsmouth | Clinic & Home Visits | Promedico";

const pageDescription =
  "Earwax removal in Portsmouth from Promedico, with clinic appointments at Somerstown Central Community Hub in Southsea and home visits across Portsmouth.";

const faqItems = [
  {
    question: "Where is the Promedico earwax removal clinic in Portsmouth?",
    answer:
      "Promedico clinic appointments are available at Somerstown Central Community Hub, Winston Churchill Avenue, Southsea, Portsmouth, PO5 4JJ. Appointments must be booked in advance."
  },
  {
    question: "Do you offer home visit earwax removal in Portsmouth?",
    answer:
      "Yes. Promedico provides home visit earwax removal across Portsmouth for patients who prefer to be seen at home or who may find travelling to clinic less convenient."
  },
  {
    question: "How much does earwax removal cost in Portsmouth?",
    answer:
      "Portsmouth clinic appointments are priced at £60. Portsmouth home visit appointments are priced at £80. Each appointment includes ear assessment and earwax removal where appropriate."
  },
  {
    question: "Is earwax removal always carried out at the appointment?",
    answer:
      "No. Each appointment starts with an assessment. Earwax removal is only carried out where wax is present and treatment is suitable. If removal is not appropriate, you will be given clear advice."
  },
  {
    question: "Which earwax removal methods are available in Portsmouth?",
    answer:
      "Promedico may use clinically recognised methods such as microsuction or ear irrigation where appropriate. The method used depends on the ear assessment, suitability and appointment setting."
  },
  {
    question: "How do I book earwax removal in Portsmouth?",
    answer:
      "Portsmouth clinic appointments can be booked online. Portsmouth home visits can be requested using the home visit enquiry option so availability can be confirmed."
  }
];
const portsmouthSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${siteUrl}/services/ear-care/portsmouth#service`,
    name: "Earwax Removal Portsmouth",
    serviceType: "Ear assessment and earwax removal",
    description: pageDescription,
    provider: {
      "@id": `${siteUrl}/services/ear-care/portsmouth#clinic`
    },
    areaServed: [
      {
        "@type": "City",
        name: "Portsmouth"
      },
      {
        "@type": "Place",
        name: "Southsea"
      }
    ],
    offers: [
      {
        "@type": "Offer",
        name: "Portsmouth clinic earwax removal appointment",
        price: "60",
        priceCurrency: "GBP",
        availability: "https://schema.org/InStock",
        url: `${siteUrl}/services/ear-care/portsmouth`
      },
      {
        "@type": "Offer",
        name: "Portsmouth home visit earwax removal appointment",
        price: "80",
        priceCurrency: "GBP",
        availability: "https://schema.org/InStock",
        url: `${siteUrl}/services/ear-care/portsmouth`
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "MedicalBusiness",
    "@id": `${siteUrl}/#organization`,
    name: "Promedico Wellness Group",
    url: siteUrl,
    logo: `${siteUrl}/images/ProMedico-Logo-text.webp`,
    image: `${siteUrl}${pageImage}`,
    telephone: "+447777100716",
    email: "reception@promedico.co.uk",
    priceRange: "££",
    address: {
      "@type": "PostalAddress",
      streetAddress: "Somerstown Central Community Hub, Winston Churchill Avenue",
      addressLocality: "Southsea",
      addressRegion: "Portsmouth",
      postalCode: "PO5 4JJ",
      addressCountry: "GB"
    },
    areaServed: [
      {
        "@type": "City",
        name: "Portsmouth"
      },
      {
        "@type": "Place",
        name: "Southsea"
      },
      {
        "@type": "Place",
        name: "Fratton"
      },
      {
        "@type": "Place",
        name: "Milton"
      },
      {
        "@type": "Place",
        name: "Eastney"
      },
      {
        "@type": "Place",
        name: "Copnor"
      },
      {
        "@type": "Place",
        name: "North End"
      },
      {
        "@type": "Place",
        name: "Hilsea"
      },
      {
        "@type": "Place",
        name: "Cosham"
      },
      {
        "@type": "Place",
        name: "Drayton"
      },
      {
        "@type": "Place",
        name: "Farlington"
      },
      {
        "@type": "Place",
        name: "Port Solent"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${siteUrl}/services/ear-care/portsmouth#webpage`,
    url: `${siteUrl}/services/ear-care/portsmouth`,
    name: pageTitle,
    description: pageDescription,
    inLanguage: "en-GB",
    about: {
      "@id": `${siteUrl}/services/ear-care/portsmouth#service`
    },
    isPartOf: {
      "@id": `${siteUrl}/#website`
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${siteUrl}/services/ear-care/portsmouth#faq`,
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer
      }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${siteUrl}/services/ear-care/portsmouth#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: `${siteUrl}/`
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Ear Care",
        item: `${siteUrl}/services/ear-care`
      },
      {
        "@type": "ListItem",
        position: 3,
        name: "Portsmouth",
        item: `${siteUrl}/services/ear-care/portsmouth`
      }
    ]
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={pageImage}
  ogTitle="Earwax Removal Portsmouth | Clinic & Home Visits"
  ogDescription="Earwax removal in Portsmouth from Promedico, with Southsea clinic appointments and home visits across Portsmouth."
  schema={portsmouthSchema}
  preloadImage="/images/earwax/earwax-portsmouth-hero.webp"
>
    <section class="hero hero--image hero--portsmouth-ear-care" aria-labelledby="portsmouth-hero-heading">
      <div class="hero__bg-pattern" aria-hidden="true"></div>

      <div class="container">
        <div class="hero__inner">
          <p class="hero__eyebrow">Portsmouth Ear Care</p>

          <h1 class="hero__heading" id="portsmouth-hero-heading">
            Earwax Removal<br />
            <span class="hero__heading-accent">in Portsmouth</span>
          </h1>

          <p class="hero__subheading">
            Practitioner-led ear care in Portsmouth, with clinic appointments at Somerstown Central
            Community Hub and home visits available across the local area.
          </p>

          <div class="hero__ctas">
            <a class="btn btn--primary" href={bookingUrl} target="_blank" rel="noopener">
              Book Online
            </a>

            <a class="btn btn--outline-light" href="#appointment-options">
              View Appointment Options
            </a>
          </div>

          <ul class="hero__trust-list" aria-label="Portsmouth ear care appointment options">
            <li class="hero__trust-item">Portsmouth clinic appointments</li>
            <li class="hero__trust-item">Portsmouth home visits</li>
            <li class="hero__trust-item">Practitioner-led ear care</li>
            <li class="hero__trust-item">Assessment before treatment</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section section--light" id="appointment-options" aria-labelledby="appointment-options-heading">
      <div class="container">
        <header class="section-header">
          <h2 class="section-header__heading" id="appointment-options-heading">
            Choose Your Portsmouth Appointment Type
          </h2>

          <p class="section-header__lead">
            Promedico offers two appointment options for earwax removal in Portsmouth: a clinic
            appointment in Southsea or a home visit across Portsmouth.
          </p>
        </header>

        <ul class="service-cards">
          <li class="service-card">
            <div class="service-card__body">
              <div class="service-card__header">
                <div class="service-card__icon-wrap" aria-hidden="true">
                  <span aria-hidden="true" set:html={BuildingIcon}></span>
                </div>

                <h3 class="service-card__heading">Clinic Appointment</h3>
              </div>

              <p class="service-card__text">
                Attend a Portsmouth clinic appointment at Somerstown Central Community Hub in
                Southsea.
              </p>

              <ul class="service-card__features">
                <li>Clinic-based ear care appointment</li>
                <li>Convenient Southsea location</li>
                <li>Assessment and treatment where appropriate</li>
              </ul>

              <a class="btn btn--primary service-card__link" href={bookingUrl} target="_blank" rel="noopener">
                Book Clinic Appointment
              </a>
            </div>
          </li>

          <li class="service-card">
            <div class="service-card__body">
              <div class="service-card__header">
                <div class="service-card__icon-wrap" aria-hidden="true">
                  <span aria-hidden="true" set:html={HouseMedicalIcon}></span>
                </div>

                <h3 class="service-card__heading">Home Visit</h3>
              </div>

              <p class="service-card__text">
                Arrange earwax removal at home if travelling to clinic is less convenient or you
                prefer to be seen in your own environment.
              </p>

              <ul class="service-card__features">
                <li>Home visits across Portsmouth</li>
                <li>Care delivered in your own home</li>
                <li>Suitable for patients who prefer not to travel</li>
              </ul>

              <button class="btn btn--primary service-card__link" type="button" data-home-visit-open>
                Book Home Visit
              </button>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="assessment-heading">
      <div class="container">
        <header class="section-header">
          <h2 class="section-header__heading" id="assessment-heading">
            Earwax Removal with Clinical Assessment First
          </h2>

          <p class="section-header__lead">
            Earwax removal should start with a clear assessment. Your ears are checked before
            treatment is considered, and removal is only carried out where appropriate.
          </p>
        </header>

        <div class="procedure-cards">
          <article class="procedure-card">
            <div class="procedure-card__body">
              <p class="procedure-card__eyebrow">Assessment</p>

              <div class="procedure-card__header">
                <div class="procedure-card__icon-wrap" aria-hidden="true">
                  <span aria-hidden="true" set:html={ClipboardMedicalIcon}></span>
                </div>

                <h3 class="procedure-card__title">Checking Suitability</h3>
              </div>

              <p class="procedure-card__text">
                Your symptoms are discussed and your ears are examined to check whether wax is
                present and whether treatment is suitable.
              </p>
            </div>
          </article>

          <article class="procedure-card">
            <div class="procedure-card__body">
              <p class="procedure-card__eyebrow">Treatment</p>

              <div class="procedure-card__header">
                <div class="procedure-card__icon-wrap" aria-hidden="true">
                  <span aria-hidden="true" set:html={EarListenIcon}></span>
                </div>

                <h3 class="procedure-card__title">Removal Where Appropriate</h3>
              </div>

              <p class="procedure-card__text">
                If treatment is suitable, earwax removal may be carried out using an appropriate
                clinical method, such as microsuction or ear irrigation.
              </p>
            </div>
          </article>

          <article class="procedure-card">
            <div class="procedure-card__body">
              <p class="procedure-card__eyebrow">Advice</p>

              <div class="procedure-card__header">
                <div class="procedure-card__icon-wrap" aria-hidden="true">
                  <span aria-hidden="true" set:html={CommentMedicalIcon}></span>
                </div>

                <h3 class="procedure-card__title">Clear Next Steps</h3>
              </div>

              <p class="procedure-card__text">
                You will receive aftercare advice and guidance on what to do if symptoms persist or
                further support is needed.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="svc-pricing" aria-labelledby="pricing-heading">
      <div class="container">
        <header class="section-header section-header--center">
          <h2 class="section-header__heading" id="pricing-heading">
            Portsmouth Earwax Removal Pricing
          </h2>

          <p class="section-header__lead">
            Clear pricing for Portsmouth clinic appointments and home visits.
          </p>
        </header>

        <div class="pricing-cards pricing-cards--two-col">
          <article class="pricing-card pricing-card--featured">
            <p class="pricing-card__label">Clinic</p>

            <h3 class="pricing-card__name">Clinic Appointment</h3>

            <div class="pricing-card__price">
              <span class="price-currency">£</span>
              <span class="price-amount">60</span>
            </div>

            <p class="pricing-card__description">
              Ear assessment and earwax removal where appropriate at the Portsmouth clinic.
            </p>

            <a class="btn btn--primary" href={bookingUrl} target="_blank" rel="noopener">
              Book Online
            </a>
          </article>

          <article class="pricing-card">
            <p class="pricing-card__label">Home Visit</p>

            <h3 class="pricing-card__name">Home Visit Appointment</h3>

            <div class="pricing-card__price">
              <span class="price-currency">£</span>
              <span class="price-amount">80</span>
            </div>

            <p class="pricing-card__description">
              Ear assessment and earwax removal where appropriate in your own home across Portsmouth.
            </p>

            <button class="btn btn--primary" type="button" data-home-visit-open>
              Request Home Visit
            </button>
          </article>
        </div>
      </div>
    </section>

    <section class="section section--light" aria-labelledby="clinic-location-heading">
      <div class="container">
        <header class="section-header">
          <h2 class="section-header__heading" id="clinic-location-heading">
            Portsmouth Clinic Location
          </h2>

          <p class="section-header__lead">
            Clinic appointments are available at Somerstown Central Community Hub in Southsea,
            Portsmouth.
          </p>
        </header>

        <ul class="service-cards">
          <li class="service-card">
            <div class="service-card__body">
              <div class="service-card__header">
                <div class="service-card__icon-wrap" aria-hidden="true">
                  <span aria-hidden="true" set:html={LocationDotIcon}></span>
                </div>

                <h3 class="service-card__heading">Clinic Address</h3>
              </div>

              <p class="service-card__text">
                <strong>
                  Somerstown Central Community Hub<br />
                  Winston Churchill Avenue<br />
                  Southsea<br />
                  Portsmouth<br />
                  PO5 4JJ
                </strong>
              </p>

              <p class="service-card__text">
                Please book online before attending. The clinic location is used for scheduled
                appointments only.
              </p>

              <a class="btn btn--primary service-card__link" href={bookingUrl} target="_blank" rel="noopener">
                Book Clinic Appointment
              </a>
            </div>
          </li>

          <li class="service-card">
            <div class="service-card__body">
              <div class="service-card__header">
                <div class="service-card__icon-wrap" aria-hidden="true">
                  <span aria-hidden="true" set:html={CarSideIcon}></span>
                </div>

                <h3 class="service-card__heading">Home Visits</h3>
              </div>

              <p class="service-card__text">
                Home visits are available across Portsmouth for patients who prefer to be seen at
                home or who may find travelling to clinic less convenient.
              </p>

              <ul class="service-card__features">
                <li>Portsmouth home visits</li>
                <li>Appointment required</li>
                <li>Useful if travel is difficult</li>
              </ul>

              <button class="btn btn--primary service-card__link" type="button" data-home-visit-open>
                Book Home Visit
              </button>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <section class="svc-areas" aria-labelledby="areas-heading">
      <div class="container">
        <header class="section-header">
          <h2 class="section-header__heading" id="areas-heading">
            Earwax Removal Across Portsmouth
          </h2>

          <p class="section-header__lead">
            Promedico provides clinic appointments in Southsea and home visits across Portsmouth and
            nearby areas.
          </p>
        </header>

        <div class="area-grid" aria-label="Portsmouth areas covered">
          <div class="area-item">Southsea</div>
          <div class="area-item">Portsmouth</div>
          <div class="area-item">Fratton</div>
          <div class="area-item">Milton</div>
          <div class="area-item">Eastney</div>
          <div class="area-item">Copnor</div>
          <div class="area-item">North End</div>
          <div class="area-item">Hilsea</div>
          <div class="area-item">Cosham</div>
          <div class="area-item">Drayton</div>
          <div class="area-item">Farlington</div>
          <div class="area-item">Port Solent</div>
        </div>

        <p class="svc-areas__note">
          If your area is not listed, contact us before booking and we can advise on home visit
          availability.
        </p>
      </div>
    </section>

    <section class="section section--light" aria-labelledby="symptoms-heading">
      <div class="container">
        <header class="section-header">
          <h2 class="section-header__heading" id="symptoms-heading">
            When Earwax May Need Attention
          </h2>

          <p class="section-header__lead">
            Earwax build-up can affect hearing, comfort and day-to-day life. Assessment is important
            because not every ear symptom is caused by wax.
          </p>
        </header>

        <div class="procedure-cards">
          <article class="procedure-card">
            <div class="procedure-card__body">
              <p class="procedure-card__eyebrow">Common concern</p>

              <div class="procedure-card__header">
                <div class="procedure-card__icon-wrap" aria-hidden="true">
                  <span aria-hidden="true" set:html={EarDeafIcon}></span>
                </div>

                <h3 class="procedure-card__title">Blocked or Full Ears</h3>
              </div>

              <p class="procedure-card__text">
                A blocked or full sensation can be associated with wax build-up, but the ear should
                be assessed before treatment is carried out.
              </p>
            </div>
          </article>

          <article class="procedure-card">
            <div class="procedure-card__body">
              <p class="procedure-card__eyebrow">Common concern</p>

              <div class="procedure-card__header">
                <div class="procedure-card__icon-wrap" aria-hidden="true">
                  <span aria-hidden="true" set:html={VolumeLowIcon}></span>
                </div>

                <h3 class="procedure-card__title">Reduced Hearing</h3>
              </div>

              <p class="procedure-card__text">
                Wax can sometimes reduce hearing clarity. Assessment helps confirm whether wax is
                present and whether removal is appropriate.
              </p>
            </div>
          </article>

          <article class="procedure-card">
            <div class="procedure-card__body">
              <p class="procedure-card__eyebrow">Common concern</p>

              <div class="procedure-card__header">
                <div class="procedure-card__icon-wrap" aria-hidden="true">
                  <span aria-hidden="true" set:html={CircleInfoIcon}></span>
                </div>

                <h3 class="procedure-card__title">Ongoing Discomfort</h3>
              </div>

              <p class="procedure-card__text">
                If symptoms persist or treatment is not suitable, you will be advised on the next
                appropriate step.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="why-heading">
      <div class="container">
        <header class="section-header">
          <h2 class="section-header__heading" id="why-heading">
            Why Choose Promedico for Earwax Removal in Portsmouth?
          </h2>

          <p class="section-header__lead">
            Promedico provides practitioner-led ear care with a clinical, conservative and
            patient-centred approach.
          </p>
        </header>

        <ul class="service-cards">
          <li class="service-card">
            <div class="service-card__body">
              <div class="service-card__header">
                <div class="service-card__icon-wrap" aria-hidden="true">
                  <span aria-hidden="true" set:html={UserDoctorIcon}></span>
                </div>

                <h3 class="service-card__heading">Practitioner-Led Care</h3>
              </div>

              <p class="service-card__text">
                Appointments are delivered by trained practitioners working within their scope, with
                clinical leadership from an experienced Advanced Clinical Practitioner.
              </p>
            </div>
          </li>

          <li class="service-card">
            <div class="service-card__body">
              <div class="service-card__header">
                <div class="service-card__icon-wrap" aria-hidden="true">
                  <span aria-hidden="true" set:html={HandHoldingMedicalIcon}></span>
                </div>

                <h3 class="service-card__heading">Appropriate Treatment</h3>
              </div>

              <p class="service-card__text">
                Treatment is only carried out where suitable. If removal is not appropriate, you will
                be given clear advice on the next step.
              </p>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <section class="svc-booking" aria-labelledby="booking-heading">
      <div class="container">
        <div class="svc-booking__inner svc-booking__inner--no-map">
          <div class="svc-booking__content">
            <p class="svc-booking__eyebrow">Book an appointment</p>

            <h2 class="svc-booking__heading" id="booking-heading">
              Book Earwax Removal in Portsmouth
            </h2>

            <p class="svc-booking__text">
              Book online for Portsmouth clinic appointments. For Portsmouth home visits, use the
              home visit request option so we can confirm your area and appointment availability.
            </p>

            <ul class="svc-booking__meta">
              <li>Clinic appointments at Somerstown Central Community Hub</li>
              <li>Home visits available across Portsmouth</li>
              <li><a href="/contact">Questions? Contact us</a></li>
            </ul>

            <div class="svc-booking__ctas">
              <a class="btn btn--primary" href={bookingUrl} target="_blank" rel="noopener">
                Book Clinic Appointment
              </a>

              <button class="btn btn--outline" type="button" data-home-visit-open>
                Request Home Visit
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="faq-section faq-section--light" aria-labelledby="portsmouth-faq-heading">
      <div class="container">
        <header class="section-header">
          <h2 class="section-header__heading" id="portsmouth-faq-heading">
            Portsmouth Earwax Removal FAQs
          </h2>

          <p class="section-header__lead">
            Clear answers to common questions about Portsmouth clinic appointments,
            home visits, pricing and earwax removal methods.
          </p>
        </header>

        <div class="faq-grid">
          <dl class="faq-list">
            {
              faqItems.map((item, index) => {
                const questionId = `portsmouth-faq-question-${index}`;
                const answerId = `portsmouth-faq-answer-${index}`;

                return (
                  <div class="faq-item">
                    <dt class="faq-item__question">
                      <button
                        class="faq-item__trigger"
                        type="button"
                        aria-expanded="false"
                        aria-controls={answerId}
                        id={questionId}
                      >
                        <span>{item.question}</span>
                        <span class="faq-item__icon" aria-hidden="true"></span>
                      </button>
                    </dt>

                    <dd
                      class="faq-item__answer"
                      id={answerId}
                      aria-labelledby={questionId}
                      hidden
                    >
                      <div class="faq-item__answer-inner">
                        <p>{item.answer}</p>
                      </div>
                    </dd>
                  </div>
                );
              })
            }
          </dl>
        </div>
      </div>
    </section>
    <script>
      const faqTriggers = document.querySelectorAll(".faq-item__trigger");

      faqTriggers.forEach((trigger) => {
        trigger.addEventListener("click", () => {
          const expanded = trigger.getAttribute("aria-expanded") === "true";
          const answerId = trigger.getAttribute("aria-controls");
          const answer = answerId ? document.getElementById(answerId) : null;

          trigger.setAttribute("aria-expanded", String(!expanded));

          if (answer) {
            answer.hidden = expanded;
          }
        });
      });
    </script>
    <HomeVisitModal defaultArea="portsmouth" />
</BaseLayout>