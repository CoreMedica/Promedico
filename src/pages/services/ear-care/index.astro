---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ServiceExpect from "../../../components/service/ServiceExpect.astro";
import "../../../styles/pages/_earwax.scss";

import BuildingIcon from "../../../assets/icons/fontawesome/building.svg?raw";
import LocationDotIcon from "../../../assets/icons/fontawesome/location-dot.svg?raw";
import ClipboardMedicalIcon from "../../../assets/icons/fontawesome/clipboard-medical.svg?raw";
import EarListenIcon from "../../../assets/icons/fontawesome/ear-listen.svg?raw";
import CommentMedicalIcon from "../../../assets/icons/fontawesome/comment-medical.svg?raw";

const bookingUrl =
  "https://promedico-ear-clinic.uk2.cliniko.com/bookings?business_id=1799806171821907984";

const siteUrl = "https://promedico.co.uk";

const pageTitle =
  "Ear Care Services | Portsmouth & Southampton | Promedico";

const pageDescription =
  "Private ear care and earwax removal services from Promedico, with clinic appointments and home visits available in Portsmouth and Southampton.";

const pageImage = "/images/team/jacqueline-allen.webp";

const faqItems = [
  {
    question: "What ear care services does Promedico provide?",
    answer:
      "Promedico provides private ear assessment and earwax removal where appropriate, with clinic appointments and home visits available in Portsmouth and Southampton."
  },
  {
    question: "Do I need a clinic appointment or a home visit?",
    answer:
      "Choose a clinic appointment if you prefer to attend a local Promedico clinic in Portsmouth or Southampton. Choose a home visit if travelling is less convenient or you prefer to be seen at home."
  },
  {
    question: "Is earwax removal always carried out at the appointment?",
    answer:
      "No. Each appointment starts with an assessment. Earwax removal is only carried out where wax is present and treatment is suitable. If removal is not appropriate, you will be given clear advice on the next step."
  },
  {
    question: "Which earwax removal methods are available?",
    answer:
      "Promedico may use clinically recognised earwax removal methods such as microsuction or ear irrigation where appropriate. The method used depends on the assessment, suitability and appointment setting."
  },
  {
    question: "Can Promedico help if I am not sure whether my symptoms are caused by earwax?",
    answer:
      "Yes. An appointment can help establish whether wax is present and whether earwax removal is suitable. Not every blocked, full or uncomfortable ear is caused by wax, so assessment comes first."
  },
  {
    question: "How do I book an ear care appointment?",
    answer:
      "Clinic appointments can be booked online. Home visits in Portsmouth or Southampton can be requested by enquiry so Promedico can confirm your area, appointment type and availability."
  }
];

const earCareSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${siteUrl}/services/ear-care#service`,
    name: "Ear Care Services",
    serviceType: "Ear assessment and earwax removal",
    description: pageDescription,
    provider: {
      "@id": `${siteUrl}/#organization`
    },
    areaServed: [
      {
        "@type": "City",
        name: "Portsmouth"
      },
      {
        "@type": "City",
        name: "Southampton"
      }
    ],
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Promedico ear care appointment options",
      itemListElement: [
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Portsmouth clinic ear care appointment"
          }
        },
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Portsmouth home visit ear care appointment"
          }
        },
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Southampton clinic ear care appointment"
          }
        },
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Southampton home visit ear care appointment"
          }
        }
      ]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${siteUrl}/services/ear-care#webpage`,
    url: `${siteUrl}/services/ear-care`,
    name: pageTitle,
    description: pageDescription,
    inLanguage: "en-GB",
    about: {
      "@id": `${siteUrl}/services/ear-care#service`
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${siteUrl}/services/ear-care#faq`,
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer
      }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${siteUrl}/services/ear-care#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: `${siteUrl}/`
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Ear Care",
        item: `${siteUrl}/services/ear-care`
      }
    ]
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={pageImage}
  ogTitle="Ear Care Services | Portsmouth & Southampton"
  ogDescription="Private ear care and earwax removal services from Promedico, with Portsmouth clinic appointments and local home visits."
  schema={earCareSchema}
  preloadImage="/images/earwax/earwax-portsmouth-hero.webp"
>
    <section class="hero hero--image hero--ear-care" aria-labelledby="ear-care-hero-heading">
      <div class="hero__bg-pattern" aria-hidden="true"></div>

      <div class="container">
        <div class="hero__inner">
          <p class="hero__eyebrow">Ear Care Services</p>

          <h1 class="hero__heading" id="ear-care-hero-heading">
            Professional Ear Care<br />
            <span class="hero__heading-accent">in Portsmouth and Southampton</span>
          </h1>

          <p class="hero__subheading">
            Practitioner-led earwax removal and ear care appointments, with clinic appointments
            and home visits available in Portsmouth and Southampton.
          </p>

          <div class="hero__ctas">
            <a class="btn btn--primary" href={bookingUrl} target="_blank" rel="noopener">
              Book Online
            </a>

            <a class="btn btn--outline-light" href="#choose-service">
              Choose Your Service
            </a>
          </div>

          <ul class="hero__trust-list" aria-label="Promedico ear care options">
            <li class="hero__trust-item">Portsmouth clinic appointments</li>
            <li class="hero__trust-item">Southampton clinic appointments</li>
            <li class="hero__trust-item">Home visits available in both areas</li>
            <li class="hero__trust-item">Practitioner-led ear care</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section section--light" id="choose-service" aria-labelledby="choose-service-heading">
      <div class="container">
        <header class="section-header">
          <h2 class="section-header__heading" id="choose-service-heading">
            Choose Your Ear Care Service
          </h2>

          <p class="section-header__lead">
            Promedico currently provides earwax removal in Portsmouth and Southampton. Choose the
            service page that matches your location and preferred appointment type.
          </p>
        </header>

        <ul class="service-cards">
          <li class="service-card">
            <div class="service-card__body">
              <div class="service-card__header">
                <div class="service-card__icon-wrap" aria-hidden="true">
                  <span aria-hidden="true" set:html={BuildingIcon}></span>
                </div>

                <h3 class="service-card__heading">Portsmouth Ear Care</h3>
              </div>

              <p class="service-card__text">
                Earwax removal in Portsmouth with both clinic appointments and home visits available.
              </p>

              <ul class="service-card__features">
                <li>Clinic appointments available</li>
                <li>Home visits available</li>
                <li>Suitable for Portsmouth patients</li>
              </ul>

              <a class="btn btn--primary service-card__link" href="/services/ear-care/portsmouth">
                View Portsmouth Service
              </a>
            </div>
          </li>

          <li class="service-card">
            <div class="service-card__body">
              <div class="service-card__header">
                <div class="service-card__icon-wrap" aria-hidden="true">
                  <span aria-hidden="true" set:html={LocationDotIcon}></span>
                </div>

                <h3 class="service-card__heading">Southampton Ear Care</h3>
              </div>

              <p class="service-card__text">
                Earwax removal in Southampton with both clinic appointments in Bitterne and home visits available.
              </p>

              <ul class="service-card__features">
                <li>Clinic appointments in Bitterne</li>
                <li>Home visits across Southampton</li>
                <li>Suitable for Southampton patients</li>
              </ul>

              <a class="btn btn--primary service-card__link" href="/services/ear-care/southampton">
                View Southampton Service
              </a>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="earwax-removal-heading">
      <div class="container">
        <header class="section-header">
          <h2 class="section-header__heading" id="earwax-removal-heading">
            Earwax Removal with Assessment First
          </h2>

          <p class="section-header__lead">
            Earwax removal should start with a clear assessment. Promedico checks whether wax is
            present, whether removal is appropriate, and which appointment option is most suitable.
          </p>
        </header>

        <div class="procedure-cards">
          <article class="procedure-card">
            <div class="procedure-card__body">
              <p class="procedure-card__eyebrow">Assessment</p>

              <div class="procedure-card__header">
                <div class="procedure-card__icon-wrap" aria-hidden="true">
                  <span aria-hidden="true" set:html={ClipboardMedicalIcon}></span>
                </div>

                <h3 class="procedure-card__title">Checking Suitability</h3>
              </div>

              <p class="procedure-card__text">
                Your symptoms are discussed and the ears are examined before treatment is considered.
                This helps confirm whether earwax removal is appropriate.
              </p>
            </div>
          </article>

          <article class="procedure-card">
            <div class="procedure-card__body">
              <p class="procedure-card__eyebrow">Treatment</p>

              <div class="procedure-card__header">
                <div class="procedure-card__icon-wrap" aria-hidden="true">
                  <span aria-hidden="true" set:html={EarListenIcon}></span>
                </div>

                <h3 class="procedure-card__title">Removal Where Appropriate</h3>
              </div>

              <p class="procedure-card__text">
                Where suitable, earwax removal may be carried out using an appropriate clinical
                method, such as microsuction or ear irrigation.
              </p>
            </div>
          </article>

          <article class="procedure-card">
            <div class="procedure-card__body">
              <p class="procedure-card__eyebrow">Advice</p>

              <div class="procedure-card__header">
                <div class="procedure-card__icon-wrap" aria-hidden="true">
                  <span aria-hidden="true" set:html={CommentMedicalIcon}></span>
                </div>

                <h3 class="procedure-card__title">Clear Next Steps</h3>
              </div>

              <p class="procedure-card__text">
                If treatment is not suitable, you will be given clear guidance on the next
                appropriate step.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <ServiceExpect
      title="What to Expect at Your Ear Care Appointment"
      intro="Your appointment follows a structured process designed around safety, comfort and appropriate care."
      items={[
        {
          title: "Initial assessment",
          text: "Your symptoms will be discussed and your ears examined to check whether wax is present and whether removal is suitable."
        },
        {
          title: "Treatment where appropriate",
          text: "If treatment is suitable, earwax removal will be carried out carefully using an appropriate method."
        },
        {
          title: "Aftercare advice",
          text: "You will receive clear aftercare advice and guidance on what to do if symptoms persist or further support is needed."
        }
      ]}
      closingSentence="The same professional standard of care applies whether your appointment takes place at home or in clinic."
      ctaText="Contact Us"
      ctaHref="/contact"
    />

    <section class="section section--light" aria-labelledby="symptoms-heading">
      <div class="container">
        <header class="section-header">
          <h2 class="section-header__heading" id="symptoms-heading">
            When Earwax May Need Attention
          </h2>

          <p class="section-header__lead">
            Earwax build-up can cause symptoms that affect hearing, comfort and day-to-day life.
            Assessment is important because not every ear symptom is caused by wax.
          </p>
        </header>

        <div class="procedure-cards">
          <article class="procedure-card">
            <div class="procedure-card__body">
              <h3 class="procedure-card__title">Blocked or Full Ears</h3>

              <p class="procedure-card__text">
                A blocked or full sensation may be associated with wax build-up, but the ear should
                be assessed before any treatment is carried out.
              </p>
            </div>
          </article>

          <article class="procedure-card">
            <div class="procedure-card__body">
              <h3 class="procedure-card__title">Reduced Hearing</h3>

              <p class="procedure-card__text">
                Wax can sometimes reduce hearing clarity. An appointment can help establish whether
                wax is present and whether removal is appropriate.
              </p>
            </div>
          </article>

          <article class="procedure-card">
            <div class="procedure-card__body">
              <h3 class="procedure-card__title">Discomfort or Irritation</h3>

              <p class="procedure-card__text">
                If you have discomfort, irritation or ongoing symptoms, assessment helps identify
                whether earwax removal is suitable or whether further advice is needed.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="why-heading">
      <div class="container">
        <header class="section-header">
          <h2 class="section-header__heading" id="why-heading">
            Why Choose Promedico for Ear Care?
          </h2>

          <p class="section-header__lead">
            Promedico provides practitioner-led ear care with a conservative, clinical and
            patient-centred approach.
          </p>
        </header>

        <ul class="service-cards">
          <li class="service-card">
            <div class="service-card__body">
              <h3 class="service-card__heading">Practitioner-Led Care</h3>

              <p class="service-card__text">
                Appointments are delivered by trained practitioners working within their scope, with
                clinical leadership from an experienced Advanced Clinical Practitioner.
              </p>
            </div>
          </li>

          <li class="service-card">
            <div class="service-card__body">
              <h3 class="service-card__heading">Clinic and Home Visit Options</h3>

              <p class="service-card__text">
                Choose the setting that suits you, with clinic appointments and home visits available
                in Portsmouth and Southampton.
              </p>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <section class="section section--light" aria-labelledby="right-option-heading">
      <div class="container">
        <header class="section-header">
          <h2 class="section-header__heading" id="right-option-heading">
            Which Option Is Right for You?
          </h2>

          <p class="section-header__lead">
            Choose the Portsmouth or Southampton service page depending on your location. Both areas
            offer clinic appointments and home visits.
          </p>
        </header>

        <ul class="service-cards">
          <li class="service-card">
            <div class="service-card__body">
              <h3 class="service-card__heading">Choose Portsmouth</h3>

              <p class="service-card__text">
                For clinic appointments at Somerstown Central Community Hub in Southsea or home visits
                across Portsmouth.
              </p>

              <a class="btn btn--primary service-card__link" href="/services/ear-care/portsmouth">
                Portsmouth Ear Care
              </a>
            </div>
          </li>

          <li class="service-card">
            <div class="service-card__body">
              <h3 class="service-card__heading">Choose Southampton</h3>

              <p class="service-card__text">
                For clinic appointments at 4 Chessel Avenue in Bitterne or home visits across
                Southampton.
              </p>

              <a class="btn btn--primary service-card__link" href="/services/ear-care/southampton">
                Southampton Ear Care
              </a>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <section class="svc-booking" aria-labelledby="booking-heading">
      <div class="container">
        <div class="svc-booking__inner svc-booking__inner--no-map">
          <div class="svc-booking__content">
            <p class="svc-booking__eyebrow">Book an appointment</p>

            <h2 class="svc-booking__heading" id="booking-heading">
              Book Your Ear Care Appointment
            </h2>

            <p class="svc-booking__text">
              Book online for clinic appointments in Portsmouth or Southampton. For home visits,
              contact Promedico so we can confirm your area and appointment availability.
            </p>

            <ul class="svc-booking__meta">
              <li>Clinic appointments available in Portsmouth and Southampton</li>
              <li>Home visits available by enquiry in both areas</li>
              <li><a href="/contact">Questions? Contact us</a></li>
            </ul>

            <div class="svc-booking__ctas">
              <a class="btn btn--primary" href={bookingUrl} target="_blank" rel="noopener">
                Book Online
              </a>

              <a class="btn btn--outline" href="/contact">
                Contact Us
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="faq-section faq-section--light" aria-labelledby="ear-care-faq-heading">
      <div class="container">
        <header class="section-header">
          <h2 class="section-header__heading" id="ear-care-faq-heading">
            Ear Care FAQs
          </h2>

          <p class="section-header__lead">
            Clear answers to common questions about Promedico ear care appointments,
            earwax removal and choosing the right appointment type.
          </p>
        </header>

        <div class="faq-grid">
          <dl class="faq-list">
            {
              faqItems.map((item, index) => {
                const questionId = `faq-question-${index}`;
                const answerId = `faq-answer-${index}`;

                return (
                  <div class="faq-item">
                    <dt class="faq-item__question">
                      <button
                        class="faq-item__trigger"
                        type="button"
                        aria-expanded="false"
                        aria-controls={answerId}
                        id={questionId}
                      >
                        <span>{item.question}</span>
                        <span class="faq-item__icon" aria-hidden="true"></span>
                      </button>
                    </dt>

                    <dd
                      class="faq-item__answer"
                      id={answerId}
                      aria-labelledby={questionId}
                      hidden
                    >
                      <div class="faq-item__answer-inner">
                        <p>{item.answer}</p>
                      </div>
                    </dd>
                  </div>
                );
              })
            }
          </dl>
        </div>
      </div>
    </section>
    <script>
      const faqTriggers = document.querySelectorAll(".faq-item__trigger");

      faqTriggers.forEach((trigger) => {
        trigger.addEventListener("click", () => {
          const expanded = trigger.getAttribute("aria-expanded") === "true";
          const answerId = trigger.getAttribute("aria-controls");
          const answer = answerId ? document.getElementById(answerId) : null;

          trigger.setAttribute("aria-expanded", String(!expanded));

          if (answer) {
            answer.hidden = expanded;
          }
        });
      });
    </script>
</BaseLayout>