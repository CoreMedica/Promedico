---
import SiteHeader from "../components/layout/SiteHeader.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import CookieBanner from "../components/ui/CookieBanner.astro";
import "../styles/main.scss";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  twitterCard?: "summary" | "summary_large_image";
  preloadImage?: string;
}

const {
  title,
  description = "Private healthcare services from Promedico Wellness Group.",
  canonical,
  schema,
  ogTitle,
  ogDescription,
  ogImage = "/images/ProMedico-Logo-text.webp",
  ogType = "website",
  twitterCard = "summary_large_image",
  preloadImage
} = Astro.props;
  const siteUrl = Astro.site ?? new URL("https://promedico.co.uk");
  const canonicalUrl = canonical
    ? new URL(canonical, siteUrl).toString()
    : new URL(Astro.url.pathname, siteUrl).toString();

  const socialTitle = ogTitle ?? title;
  const socialDescription = ogDescription ?? description;
  const socialImageUrl = new URL(ogImage, siteUrl).toString();

  const schemaItems = Array.isArray(schema) ? schema : schema ? [schema] : [];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}
    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#2f5f5b" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Promedico Wellness Group" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={socialTitle} />
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialTitle} />
    {
      schemaItems.map((schemaItem) => (
        <script type="application/ld+json" set:html={JSON.stringify(schemaItem)} />
      ))
    }
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-B8V2LDDND1"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-B8V2LDDND1');
    </script>
    <!-- Clarity tracking code for https://promedico.co.uk/ -->
    <script is:inline>
        (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i+"?ref=bwt";
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "xxiyuvmr68");
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
    <CookieBanner />
  </body>
</html>