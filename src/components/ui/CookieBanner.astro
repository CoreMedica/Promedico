---

<div class="cookie-banner" data-cookie-banner hidden>
  <div class="cookie-banner__inner" role="dialog" aria-labelledby="cookie-banner-heading" aria-describedby="cookie-banner-text">
    <div class="cookie-banner__content">
      <h2 class="cookie-banner__heading" id="cookie-banner-heading">
        Cookies on this website
      </h2>

      <p class="cookie-banner__text" id="cookie-banner-text">
        We use essential cookies to make this website work. With your consent, we also use
        analytics and advertising cookies to understand website use and measure marketing.
        You can accept or reject non-essential cookies.
      </p>

      <p class="cookie-banner__links">
        <a href="/privacy-policy">Privacy Policy</a>
        <span aria-hidden="true"> · </span>
        <a href="/cookie-policy">Cookie Policy</a>
      </p>
    </div>

    <div class="cookie-banner__actions">
      <button class="btn btn--primary" type="button" data-cookie-accept>
        Accept all
      </button>

      <button class="btn btn--outline" type="button" data-cookie-reject>
        Reject non-essential
      </button>
    </div>
  </div>
</div>

<script src="/scripts/cookie-consent.js" defer></script>